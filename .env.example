# ===========================================
# ClawCaster Studios - Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# or set these in Vercel Dashboard for production

# -------------------------------------------
# Database (PostgreSQL - Required for Production)
# -------------------------------------------
# For Vercel Postgres (recommended):
DATABASE_URL="postgres://default:xxxxx@xxx.postgres.vercel-storage.com/verceldb?pgbouncer=true"
DIRECT_DATABASE_URL="postgres://default:xxxxx@xxx.postgres.vercel-storage.com/verceldb"

# For Supabase:
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# For local development (SQLite):
# DATABASE_URL="file:./dev.db"
# DIRECT_DATABASE_URL="file:./dev.db"

# -------------------------------------------
# AI Generation (Z.ai)
# -------------------------------------------
ZAI_API_KEY=your_zai_api_key_here

# -------------------------------------------
# Bankr API (Optional - Demo Mode available)
# -------------------------------------------
# Get your API key at: https://bankr.bot/api
BANKR_API_KEY=bk_your_api_key_here
BANKR_PRIVATE_KEY=0x_your_wallet_private_key_here

# -------------------------------------------
# Demo Mode
# -------------------------------------------
# Set to "true" for mock data without real API calls
# Set to "false" for production with real Bankr integration
DEMO_MODE=true

# -------------------------------------------
# Smart Contract (Optional - for custom contracts)
# -------------------------------------------
NEXT_PUBLIC_CLAW_RIGHTS_ADDRESS=0x0000000000000000000000000000000000000000

# -------------------------------------------
# NextAuth (Optional - for authentication)
# -------------------------------------------
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000
